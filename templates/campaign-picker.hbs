<form class="tc-campaign-picker">

  {{#if error}}
    <div class="tc-picker-error">
      <p><i class="fas fa-exclamation-triangle"></i> Could not load campaigns.</p>
      <p class="hint">{{error}}</p>
      <hr>
      <p class="hint"><strong>401 Unauthorized:</strong> your API key is invalid or not yet created. Log into the TableCodex web app, go to Settings → API Keys, generate a key with the <code>campaigns:read</code> and <code>vtt:write</code> scopes, then paste it into the TableCodex module settings in Foundry.</p>
      <p class="hint"><strong>Failed to fetch / CORS:</strong> the API server must return <code>Access-Control-Allow-Origin: *</code> headers.</p>
    </div>

  {{else if campaigns.length}}
    <div class="form-group">
      <label for="tc-campaign-select">Campaign</label>
      <div class="form-fields">
        <select id="tc-campaign-select" name="campaignId">
          <option value="">— Select a campaign —</option>
          {{#each campaigns}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>
              {{name}}{{#if system}} · {{system}}{{/if}}
            </option>
          {{/each}}
        </select>
      </div>
    </div>
    {{#if currentCampaignName}}
      <p class="hint tc-picker-current">
        <i class="fas fa-check-circle"></i> Active: <strong>{{currentCampaignName}}</strong> (ID: {{currentCampaignId}})
      </p>
    {{/if}}

  {{else}}
    <div class="tc-picker-empty">
      <p><i class="fas fa-info-circle"></i> No campaigns found in your TableCodex account.</p>
      <p class="hint">Create a campaign at table-codex.replit.app first, then come back here.</p>
    </div>
  {{/if}}

</form>
