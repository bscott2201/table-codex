<div class="tablecodex-panel-wrap">

  {{!-- Header --}}
  <header class="tc-header">
    <span class="tc-logo"><i class="fas fa-scroll"></i></span>
    <span class="tc-title">TableCodex Sync</span>
    {{#if isActive}}
      <span class="tc-badge tc-badge--recording">● Recording</span>
    {{else if hasSession}}
      <span class="tc-badge tc-badge--stopped">Stopped</span>
    {{else}}
      <span class="tc-badge tc-badge--idle">Idle</span>
    {{/if}}
  </header>

  {{!-- Connection status --}}
  <section class="tc-section">
    <h4>Connection</h4>
    <dl class="tc-dl">
      <dt>API</dt>
      <dd>
        {{#if (eq apiState "ok")}}<span class="tc-status-ok"><i class="fas fa-check-circle"></i> Connected</span>
        {{else if (eq apiState "unavailable")}}<span class="tc-status-warn"><i class="fas fa-exclamation-triangle"></i> Ping N/A — use Fetch Campaigns</span>
        {{else if (eq apiState "failed")}}<span class="tc-status-err"><i class="fas fa-times-circle"></i> Failed</span>
        {{else}}<span class="tc-status-dim"><i class="fas fa-circle"></i> Not tested</span>
        {{/if}}
      </dd>

      <dt>Campaign</dt>
      <dd>
        {{#if hasCampaign}}
          <span class="tc-status-ok"><i class="fas fa-check-circle"></i> {{campaignName}}</span>
        {{else}}
          <span class="tc-status-dim"><i class="fas fa-minus-circle"></i> Not selected</span>
        {{/if}}
      </dd>

      <dt>World link</dt>
      <dd>
        {{#if worldLinked}}
          <span class="tc-status-ok"><i class="fas fa-link"></i> Linked — {{worldName}}</span>
        {{else}}
          <span class="tc-status-dim"><i class="fas fa-unlink"></i> Not linked</span>
        {{/if}}
      </dd>

      <dt>Token</dt>
      <dd>
        {{#if hasToken}}<span class="tc-status-ok"><i class="fas fa-check-circle"></i> {{tokenHint}}</span>
        {{else}}<span class="tc-status-err"><i class="fas fa-times-circle"></i> Not configured</span>
        {{/if}}
      </dd>
    </dl>
  </section>

  {{!-- Setup: ping → fetch → select → link --}}
  <section class="tc-section">
    <h4>Setup</h4>

    <div class="tc-campaign-row">
      <button data-action="ping-api" class="tc-btn tc-btn--test tc-btn--sm tc-btn--full">
        <i class="fas fa-plug"></i> Test API Connection
      </button>
    </div>

    <div class="tc-campaign-row">
      <button data-action="fetch-campaigns" class="tc-btn tc-btn--accent tc-btn--sm tc-btn--full">
        <i class="fas fa-sync-alt"></i> Fetch Campaigns
      </button>
    </div>

    {{#if hasFetchedCampaigns}}
    <div class="tc-campaign-row">
      <select data-campaign-select class="tc-select">
        <option value="">— Select a campaign —</option>
        {{#each campaigns}}
          <option value="{{id}}" {{#if (eq id ../campaignId)}}selected{{/if}}>
            {{name}}{{#if system}} ({{system}}){{/if}}
          </option>
        {{/each}}
      </select>
    </div>
    <div class="tc-campaign-row">
      <button data-action="save-campaign" class="tc-btn tc-btn--sm" style="flex:1">
        <i class="fas fa-save"></i> Save Selection
      </button>
      <button data-action="link-world" class="tc-btn tc-btn--primary tc-btn--sm" style="flex:1"
        {{#unless hasCampaign}}disabled{{/unless}}>
        <i class="fas fa-link"></i> Link World
      </button>
    </div>
    {{else if hasCampaign}}
    <p class="tc-hint">Campaign: <strong>{{campaignName}}</strong> — click Fetch Campaigns to change.</p>
    {{/if}}
  </section>

  {{!-- Session info --}}
  {{#if hasSession}}
  <section class="tc-section">
    <h4>Session</h4>
    <dl class="tc-dl">
      {{#if sessionTitle}}<dt>Title</dt><dd>{{sessionTitle}}</dd>{{/if}}
      <dt>ID</dt><dd class="tc-mono">{{localSessionId}}</dd>
      <dt>Started</dt><dd>{{startedAt}}</dd>
      {{#unless isActive}}<dt>Ended</dt><dd>{{endedAt}}</dd>{{/unless}}
      {{#if synced}}
        <dt>Status</dt><dd><span class="tc-status-ok"><i class="fas fa-check-circle"></i> Uploaded</span></dd>
        {{#if remoteIntakeId}}<dt>Intake ID</dt><dd class="tc-mono">{{remoteIntakeId}}</dd>{{/if}}
        {{#if remoteImportId}}<dt>Import ID</dt><dd class="tc-mono">{{remoteImportId}}</dd>{{/if}}
        <dt></dt><dd class="tc-hint">Finish intake on your campaign dashboard.</dd>
      {{/if}}
    </dl>
  </section>

  <section class="tc-section">
    <h4>Captured</h4>
    <ul class="tc-stats">
      <li><i class="fas fa-comment"></i> {{stats.chatMessageCount}} chat messages</li>
      <li><i class="fas fa-dice"></i> {{stats.rollCount}} rolls</li>
      <li><i class="fas fa-swords"></i> {{stats.combatEventCount}} combat events</li>
      <li><i class="fas fa-map"></i> {{stats.sceneSnapshotCount}} scenes</li>
      <li><i class="fas fa-user"></i> {{stats.actorSnapshotCount}} actor snapshots</li>
      <li><i class="fas fa-book"></i> {{stats.journalSnapshotCount}} journals</li>
    </ul>
  </section>
  {{/if}}

  {{!-- Session actions --}}
  <section class="tc-section tc-actions">
    {{#if isActive}}
      <button data-action="end-session" class="tc-btn tc-btn--danger">
        <i class="fas fa-stop-circle"></i> End Session
      </button>
    {{else}}
      <button data-action="start-session" class="tc-btn tc-btn--primary">
        <i class="fas fa-circle"></i> Start Session
      </button>
    {{/if}}

    {{#if hasSession}}
    <div class="tc-action-row">
      <button data-action="export-json" class="tc-btn">
        <i class="fas fa-file-code"></i> Export JSON
      </button>
      <button data-action="export-md" class="tc-btn">
        <i class="fas fa-file-alt"></i> Export Markdown
      </button>
    </div>
    <div class="tc-action-row">
      <button data-action="sync-session" class="tc-btn tc-btn--accent"
        {{#unless hasCampaign}}disabled title="Select a campaign before syncing"{{/unless}}>
        <i class="fas fa-cloud-upload-alt"></i>
        {{#if synced}}Re-Sync{{else}}Sync to TableCodex{{/if}}
      </button>
      <button data-action="clear-buffer" class="tc-btn tc-btn--muted">
        <i class="fas fa-trash"></i> Clear
      </button>
    </div>
    {{/if}}
  </section>

  {{!-- Unsynced sessions notice --}}
  {{#if pendingSessionCount}}
  <section class="tc-section tc-unsynced-notice">
    <span class="tc-unsynced-badge">
      <i class="fas fa-exclamation-triangle"></i>
      {{pendingSessionCount}} unsynced session{{#if (gt pendingSessionCount 1)}}s{{/if}}
    </span>
    <button data-action="review-unsynced" class="tc-btn tc-btn--sm tc-btn--warn">
      <i class="fas fa-history"></i> Review
    </button>
  </section>
  {{/if}}

  {{!-- Footer --}}
  <footer class="tc-footer">
    <button data-action="open-settings" class="tc-btn tc-btn--sm tc-btn--settings">
      <i class="fas fa-cog"></i> Settings
    </button>
  </footer>

</div>
