<div class="tablecodex-panel-wrap">

  {{!-- Header --}}
  <header class="tc-header">
    <span class="tc-logo"><i class="fas fa-scroll"></i></span>
    <span class="tc-title">TableCodex Sync</span>
    {{#if isActive}}
      <span class="tc-badge tc-badge--recording">● Recording</span>
    {{else if hasSession}}
      <span class="tc-badge tc-badge--stopped">Stopped</span>
    {{else}}
      <span class="tc-badge tc-badge--idle">Idle</span>
    {{/if}}
  </header>

  {{!-- Status --}}
  <section class="tc-section">
    <h4>{{localize "TABLECODEX.Panel.Status"}}</h4>
    <dl class="tc-dl">
      <dt>{{localize "TABLECODEX.Panel.Status.Campaign"}}</dt>
      <dd>
        {{#if hasCampaign}}
          <span class="tc-status-ok"><i class="fas fa-check-circle"></i> {{campaignName}}</span>
        {{else}}
          <span class="tc-status-warn"><i class="fas fa-exclamation-triangle"></i> {{localize "TABLECODEX.Panel.Status.NoCampaign"}}</span>
        {{/if}}
      </dd>

      <dt>{{localize "TABLECODEX.Panel.Status.World"}}</dt>
      <dd>{{worldName}}</dd>

      <dt>{{localize "TABLECODEX.Panel.Status.Token"}}</dt>
      <dd>
        {{#if hasToken}}
          <span class="tc-status-ok"><i class="fas fa-check-circle"></i> {{tokenHint}}</span>
        {{else}}
          <span class="tc-status-warn"><i class="fas fa-exclamation-triangle"></i> {{localize "TABLECODEX.Panel.Status.NoToken"}}</span>
        {{/if}}
      </dd>

      {{#if hasSession}}
        <dt>{{localize "TABLECODEX.Panel.Status.LastSync"}}</dt>
        <dd>
          {{#if synced}}
            <span class="tc-status-ok"><i class="fas fa-cloud-check"></i> {{localize "TABLECODEX.Panel.Status.Synced"}}</span>
          {{else}}
            <span class="tc-status-warn">{{localize "TABLECODEX.Panel.Status.Unsynced"}}</span>
          {{/if}}
        </dd>
      {{/if}}
    </dl>
  </section>

  {{!-- Campaign selector --}}
  <section class="tc-section">
    <h4>{{localize "TABLECODEX.Panel.Campaign"}}</h4>

    <div class="tc-campaign-row">
      <button data-action="fetch-campaigns" class="tc-btn tc-btn--accent tc-btn--sm">
        <i class="fas fa-sync-alt"></i> {{localize "TABLECODEX.Panel.FetchCampaigns"}}
      </button>
    </div>

    {{#if hasFetchedCampaigns}}
    <div class="tc-campaign-row">
      <select data-campaign-select class="tc-select">
        <option value="">— {{localize "TABLECODEX.Panel.SelectCampaign"}} —</option>
        {{#each campaigns}}
          <option value="{{id}}" {{#if (eq id ../campaignId)}}selected{{/if}}>
            {{name}}{{#if system}} ({{system}}){{/if}}
          </option>
        {{/each}}
      </select>
    </div>
    <div class="tc-campaign-row">
      <button data-action="save-campaign" class="tc-btn tc-btn--primary tc-btn--sm tc-btn--full">
        <i class="fas fa-link"></i> {{localize "TABLECODEX.Panel.LinkCampaign"}}
      </button>
    </div>
    {{/if}}

    {{#unless hasFetchedCampaigns}}
    {{#if hasCampaign}}
    <p class="tc-hint">{{localize "TABLECODEX.Panel.CurrentCampaign"}}: <strong>{{campaignName}}</strong></p>
    {{/if}}
    {{/unless}}
  </section>

  {{!-- Session info --}}
  {{#if hasSession}}
  <section class="tc-section">
    <h4>{{localize "TABLECODEX.Panel.SessionInfo"}}</h4>
    <dl class="tc-dl">
      {{#if sessionTitle}}<dt>{{localize "TABLECODEX.Panel.SessionTitle"}}</dt><dd>{{sessionTitle}}</dd>{{/if}}
      <dt>ID</dt><dd class="tc-mono">{{localSessionId}}</dd>
      <dt>{{localize "TABLECODEX.Panel.Started"}}</dt><dd>{{startedAt}}</dd>
      {{#unless isActive}}<dt>{{localize "TABLECODEX.Panel.Ended"}}</dt><dd>{{endedAt}}</dd>{{/unless}}
      {{#if synced}}<dt>{{localize "TABLECODEX.Panel.ImportId"}}</dt><dd class="tc-mono">{{remoteImportId}}</dd>{{/if}}
    </dl>
  </section>

  <section class="tc-section">
    <h4>{{localize "TABLECODEX.Panel.Captured"}}</h4>
    <ul class="tc-stats">
      <li><i class="fas fa-comment"></i> {{stats.chatMessageCount}} {{localize "TABLECODEX.Panel.ChatMessages"}}</li>
      <li><i class="fas fa-dice"></i> {{stats.rollCount}} {{localize "TABLECODEX.Panel.Rolls"}}</li>
      <li><i class="fas fa-swords"></i> {{stats.combatEventCount}} {{localize "TABLECODEX.Panel.CombatEvents"}}</li>
      <li><i class="fas fa-map"></i> {{stats.sceneSnapshotCount}} {{localize "TABLECODEX.Panel.Scenes"}}</li>
      <li><i class="fas fa-user"></i> {{stats.actorSnapshotCount}} {{localize "TABLECODEX.Panel.ActorSnapshots"}}</li>
      <li><i class="fas fa-book"></i> {{stats.journalSnapshotCount}} {{localize "TABLECODEX.Panel.Journals"}}</li>
    </ul>
  </section>
  {{/if}}

  {{!-- Session actions --}}
  <section class="tc-section tc-actions">
    {{#if isActive}}
      <button data-action="end-session" class="tc-btn tc-btn--danger">
        <i class="fas fa-stop-circle"></i> {{localize "TABLECODEX.Panel.EndSession"}}
      </button>
    {{else}}
      <button data-action="start-session" class="tc-btn tc-btn--primary">
        <i class="fas fa-circle"></i> {{localize "TABLECODEX.Panel.StartSession"}}
      </button>
    {{/if}}

    {{#if hasSession}}
    <div class="tc-action-row">
      <button data-action="export-json" class="tc-btn">
        <i class="fas fa-file-code"></i> {{localize "TABLECODEX.Panel.ExportJson"}}
      </button>
      <button data-action="export-md" class="tc-btn">
        <i class="fas fa-file-alt"></i> {{localize "TABLECODEX.Panel.ExportMd"}}
      </button>
    </div>
    <div class="tc-action-row">
      <button data-action="sync-session" class="tc-btn tc-btn--accent"
        {{#unless hasCampaign}}disabled title="{{localize "TABLECODEX.Warn.NoCampaignForSession"}}"{{/unless}}
        {{#if synced}}title="Already synced — will re-sync"{{/if}}>
        <i class="fas fa-cloud-upload-alt"></i>
        {{#if synced}}{{localize "TABLECODEX.Panel.ReSync"}}{{else}}{{localize "TABLECODEX.Panel.Sync"}}{{/if}}
      </button>
      <button data-action="clear-buffer" class="tc-btn tc-btn--muted">
        <i class="fas fa-trash"></i> {{localize "TABLECODEX.Panel.Clear"}}
      </button>
    </div>
    {{/if}}
  </section>

  {{!-- Footer --}}
  <footer class="tc-footer">
    <button data-action="test-connection" class="tc-btn tc-btn--sm tc-btn--test">
      <i class="fas fa-plug"></i> {{localize "TABLECODEX.Panel.TestConnection"}}
    </button>
    <button data-action="open-settings" class="tc-btn tc-btn--sm tc-btn--settings">
      <i class="fas fa-cog"></i> {{localize "TABLECODEX.Panel.Settings"}}
    </button>
  </footer>

</div>
