{{!-- Rendered as a standard Foundry settings form via ApplicationV2 or FormApplication --}}
<form class="tablecodex-settings-form">
  <section>
    <h3>{{localize "TABLECODEX.Settings.Section.Api"}}</h3>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.ApiUrl.Name"}}</label>
      <div class="form-fields">
        <input type="url" name="tablecodexApiUrl" value="{{apiUrl}}" placeholder="https://app.tablecodex.com" />
      </div>
      <p class="hint">{{localize "TABLECODEX.Settings.ApiUrl.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.ApiToken.Name"}}</label>
      <div class="form-fields">
        <input type="password" name="apiToken" value="{{apiToken}}" />
      </div>
      <p class="hint">{{localize "TABLECODEX.Settings.ApiToken.Hint"}}</p>
    </div>
    <button type="button" data-action="test-connection">
      <i class="fas fa-plug"></i> {{localize "TABLECODEX.Panel.TestConnection"}}
    </button>
  </section>

  <section>
    <h3>{{localize "TABLECODEX.Settings.Section.Privacy"}}</h3>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.CaptureWhispers.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="captureWhispers" {{#if captureWhispers}}checked{{/if}} />
      </div>
      <p class="hint">{{localize "TABLECODEX.Settings.CaptureWhispers.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.CapturePrivateRolls.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="capturePrivateRolls" {{#if capturePrivateRolls}}checked{{/if}} />
      </div>
      <p class="hint">{{localize "TABLECODEX.Settings.CapturePrivateRolls.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.CaptureJournalText.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="captureJournalText" {{#if captureJournalText}}checked{{/if}} />
      </div>
      <p class="hint">{{localize "TABLECODEX.Settings.CaptureJournalText.Hint"}}</p>
    </div>
  </section>

  <section>
    <h3>{{localize "TABLECODEX.Settings.Section.Capture"}}</h3>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.CaptureActorSnapshots.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="captureActorSnapshots" {{#if captureActorSnapshots}}checked{{/if}} />
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.CaptureItemSnapshots.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="captureItemSnapshots" {{#if captureItemSnapshots}}checked{{/if}} />
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.CaptureSceneSnapshots.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="captureSceneSnapshots" {{#if captureSceneSnapshots}}checked{{/if}} />
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "TABLECODEX.Settings.AutoSync.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="autoSyncOnSessionEnd" {{#if autoSyncOnSessionEnd}}checked{{/if}} />
      </div>
      <p class="hint">{{localize "TABLECODEX.Settings.AutoSync.Hint"}}</p>
    </div>
  </section>
</form>
