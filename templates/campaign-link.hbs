{{!-- TableCodex Sync — campaign linking form (ApplicationV2) --}}
<section class="tablecodex-campaign-link">
  <p class="tc-hint">Bind this Foundry world to a TableCodex campaign. The API token is stored world-scoped.</p>

  <div class="form-group">
    <label for="tc-apiUrl">API URL</label>
    <input type="text" id="tc-apiUrl" name="apiUrl" value="{{apiUrl}}" placeholder="https://app.tablecodex.com" />
  </div>

  <div class="form-group">
    <label for="tc-apiToken">API Token</label>
    <input type="password" id="tc-apiToken" name="apiToken" value="{{apiToken}}" placeholder="tc_..." />
  </div>

  <div class="tc-actions tc-conn-actions">
    <button type="button" data-action="testConnection"><i class="fa-solid fa-plug"></i> Test connection</button>
    <button type="button" data-action="loadCampaigns"><i class="fa-solid fa-rotate"></i> Load campaigns</button>
  </div>

  {{#if status}}
    <p class="tc-conn-status {{#if status.ok}}tc-ok{{else}}tc-err{{/if}}">
      <i class="fa-solid {{#if status.ok}}fa-circle-check{{else}}fa-circle-exclamation{{/if}}"></i>
      {{status.message}}
    </p>
  {{/if}}

  {{#if hasCampaigns}}
    <div class="form-group">
      <label for="tc-campaignId">Campaign</label>
      <select id="tc-campaignId" name="campaignId">
        <option value="">— select a campaign —</option>
        {{#each campaigns as |c|}}
          <option value="{{c.id}}" {{#if c.selected}}selected{{/if}}>{{c.name}}</option>
        {{/each}}
      </select>
    </div>
  {{else}}
    <p class="tc-hint">Load campaigns to pick from a list, or enter the id manually below.</p>
    <div class="form-group">
      <label for="tc-campaignId-manual">Campaign ID</label>
      <input type="text" id="tc-campaignId-manual" name="campaignId" value="{{campaignId}}" placeholder="cmp_..." />
    </div>
    <div class="form-group">
      <label for="tc-campaignName">Campaign Name</label>
      <input type="text" id="tc-campaignName" name="campaignName" value="{{campaignName}}" placeholder="Curse of Strahd" />
    </div>
  {{/if}}

  <footer class="tc-actions">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> Save link</button>
  </footer>
</section>
